{
  "name": "knowsphere-platform",
  "version": "1.0.0",
  "description": "KnowSphere AI — AI-Powered Research & Knowledge Discovery Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
